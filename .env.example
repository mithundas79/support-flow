# Fictional local stack. Copy to ignored .env and replace the four local secrets.
POSTGRES_PASSWORD=replace-with-local-database-password
# Used only for running API scripts on the host; Compose constructs its own URL.
DATABASE_URL=postgresql://support_flow:replace-with-local-database-password@127.0.0.1:5432/support_flow
REVIEWER_TOKEN=replace-with-reviewer-secret-32-characters
WORKFLOW_TOKEN=replace-with-different-workflow-secret-32-characters
N8N_ENCRYPTION_KEY=replace-with-local-n8n-encryption-key
APP_ORIGIN=http://localhost:5173
DELIVERY_ALLOWED_DOMAINS=example.com,example.test,northstar.example
DELIVERY_MODE=mailpit
NORTHSTAR_SMTP_HOST=mailpit
NORTHSTAR_SMTP_PORT=1025
N8N_URL=http://localhost:5678
REVIEW_UI_URL=http://localhost:5173/support-flow/
# Stable namespace for the optional dedicated Gmail intake adapter.
GMAIL_MAILBOX_KEY=northstar-support

# Default controlled fixture: simulated responses and deterministic embeddings.
# Connecting React in live API mode does not change this provider mode.
AI_PROVIDER_MODE=fixture
OPENAI_BASE_URL=http://provider-fixture:4010/v1
OPENAI_API_KEY=controlled-fixture-no-real-key
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PROVIDER_TIMEOUT_MS=20000
AUTO_POLL_ENABLED=true
# Opt-in evaluation also requires AI_PROVIDER_MODE=openai, the real API URL,
# a server-side key and recreating API/n8n. It never approves or sends.
RUN_LIVE_OPENAI=0

# Optional explicit Slack notification; disabled by default.
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=
