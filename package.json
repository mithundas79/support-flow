{
  "name": "support-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @support-flow/contracts && npm run build --workspace @support-flow/api --if-present && npm run build --workspace @support-flow/web --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @support-flow/api --if-present",
    "test:e2e": "playwright test",
    "dev:web": "npm run dev --workspace @support-flow/web",
    "dev:api": "npm run dev --workspace @support-flow/api"
  },
  "devDependencies": {
    "@types/node": "22.18.11",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
