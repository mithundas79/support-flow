{
  "name": "support-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @support-flow/contracts && npm run build --workspace @support-flow/api --if-present && npm run build --workspace @support-flow/web --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @support-flow/api --if-present",
    "test:e2e": "playwright test tests/e2e/independent-demo.spec.ts",
    "dev:web": "npm run dev --workspace @support-flow/web",
    "dev:api": "npm run dev --workspace @support-flow/api",
    "test:web:e2e": "npm run test:e2e --workspace @support-flow/web",
    "test:acceptance": "node --test --test-concurrency=1 tests/acceptance/*.test.mjs",
    "check:public": "node scripts/check-demo-bundle.mjs",
    "test:automation": "node --test automation/tests/fixture.test.mjs automation/tests/gmail.test.mjs"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "2.1.9",
    "@playwright/test": "1.56.1"
  }
}
