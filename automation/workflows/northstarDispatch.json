{
  "id": "northstarDispatch",
  "name": "Northstar • dispatch exact approved snapshot",
  "active": false,
  "nodes": [
    {
      "id": "authenticated-trigger",
      "name": "Authenticated trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "northstar-dispatch",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "northstar-dispatch",
      "credentials": {
        "httpHeaderAuth": {
          "id": "northstar-webhook",
          "name": "Northstar workflow token"
        }
      }
    },
    {
      "id": "poll-approved-outbox",
      "name": "Poll approved outbox",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "automatic-dispatch-enabled",
      "name": "Automatic dispatch enabled",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ $env.AUTO_POLL_ENABLED!=='false' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "claim-approved-snapshot",
      "name": "Claim approved snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        780,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_INTERNAL_URL+'/outbox/claim' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer '+$env.WORKFLOW_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {workerId:'n8n-'+$execution.id} }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": false
    },
    {
      "id": "read-delivery-claim",
      "name": "Read delivery claim",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "if($json.statusCode!==200)return [{json:{idle:true,error:'Outbox unavailable'}}];return [{json:$json.body?.item?{item:$json.body.item}:{idle:true}}];"
      }
    },
    {
      "id": "delivery-available",
      "name": "Delivery available",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1300,
        220
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ Boolean($json.item) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "no-approved-mail",
      "name": "No approved mail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        220
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{json:{status:'idle'}}];"
      }
    },
    {
      "id": "send-approved-text-to-sink",
      "name": "Send approved text to sink",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        260,
        220
      ],
      "parameters": {
        "operation": "send",
        "fromEmail": "Northstar Support <support@northstar.example>",
        "toEmail": "={{ $json.item.to }}",
        "subject": "={{ $json.item.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.item.body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "smtp": {
          "id": "northstar-mailpit",
          "name": "Northstar configured SMTP sink"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": false
    },
    {
      "id": "interpret-smtp-outcome",
      "name": "Interpret SMTP outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        220
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item=$('Read delivery claim').first().json.item;const accepted=Array.isArray($json.accepted)&&$json.accepted.includes(item.to)&&typeof $json.messageId==='string';return [{json:{item,accepted,providerMessageId:$json.messageId||'',error:$json.error?'SMTP outcome uncertain. Inspect sink before any manual resend.':'SMTP acceptance could not be confirmed.'}}];"
      }
    },
    {
      "id": "smtp-accepted",
      "name": "SMTP accepted",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        780,
        220
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ $json.accepted }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "record-delivery",
      "name": "Record delivery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1040,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_INTERNAL_URL+'/outbox/'+$json.item.id+'/sent' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer '+$env.WORKFLOW_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {claimToken:$json.item.claimToken,providerMessageId:$json.providerMessageId} }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": false
    },
    {
      "id": "require-reconciliation",
      "name": "Require reconciliation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1300,
        440
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_INTERNAL_URL+'/outbox/'+$json.item.id+'/failure' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer '+$env.WORKFLOW_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {claimToken:$json.item.claimToken,code:'smtp_uncertain',message:$json.error,ambiguous:true} }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": false
    },
    {
      "id": "delivery-result",
      "name": "Delivery result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        440
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{json:$json.body || $json}];"
      }
    }
  ],
  "connections": {
    "Authenticated trigger": {
      "main": [
        [
          {
            "node": "Claim approved snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll approved outbox": {
      "main": [
        [
          {
            "node": "Automatic dispatch enabled",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Automatic dispatch enabled": {
      "main": [
        [
          {
            "node": "Claim approved snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim approved snapshot": {
      "main": [
        [
          {
            "node": "Read delivery claim",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read delivery claim": {
      "main": [
        [
          {
            "node": "Delivery available",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delivery available": {
      "main": [
        [
          {
            "node": "Send approved text to sink",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No approved mail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send approved text to sink": {
      "main": [
        [
          {
            "node": "Interpret SMTP outcome",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Interpret SMTP outcome": {
      "main": [
        [
          {
            "node": "SMTP accepted",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SMTP accepted": {
      "main": [
        [
          {
            "node": "Record delivery",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Require reconciliation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record delivery": {
      "main": [
        [
          {
            "node": "Delivery result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Require reconciliation": {
      "main": [
        [
          {
            "node": "Delivery result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 180,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true
  },
  "pinData": {},
  "tags": []
}
