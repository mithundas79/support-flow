{
  "id": "northstarRecover",
  "name": "Northstar • recover expired jobs safely",
  "active": false,
  "nodes": [
    {
      "id": "authenticated-trigger",
      "name": "Authenticated trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "northstar-recover",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "northstar-recover",
      "credentials": {
        "httpHeaderAuth": {
          "id": "northstar-webhook",
          "name": "Northstar workflow token"
        }
      }
    },
    {
      "id": "recover-expired-leases",
      "name": "Recover expired leases",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "automatic-recovery-enabled",
      "name": "Automatic recovery enabled",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "check",
              "leftValue": "={{ $env.AUTO_POLL_ENABLED!=='false' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "recover-durable-work",
      "name": "Recover durable work",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        780,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_INTERNAL_URL+'/maintenance/recover' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer '+$env.WORKFLOW_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {} }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": false
    },
    {
      "id": "recovery-result",
      "name": "Recovery result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{json:$json.body || $json}];"
      }
    }
  ],
  "connections": {
    "Authenticated trigger": {
      "main": [
        [
          {
            "node": "Recover durable work",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Recover expired leases": {
      "main": [
        [
          {
            "node": "Automatic recovery enabled",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Automatic recovery enabled": {
      "main": [
        [
          {
            "node": "Recover durable work",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Recover durable work": {
      "main": [
        [
          {
            "node": "Recovery result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 180,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true
  },
  "pinData": {},
  "tags": []
}
